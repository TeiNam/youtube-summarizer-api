# AWS 자격 증명
# IAM Roles Anywhere 로 이관 — 장기 액세스 키를 쓰지 않는다.
# helper 가 X.509 인증서로 11시간 임시 자격증명을 받고, SDK 가 만료 전에 다시 호출한다.
AWS_PROFILE=wl-bedrock-test
# 컨테이너면 컨테이너 안의 절대 경로로: AWS_CONFIG_FILE=/app/.aws/config
AWS_REGION=us-east-1

# API 인증키
API_KEY=your-api-key-here

# API 경로 프리픽스 (예: /yts/api)
# 프록시가 프리픽스를 벗기지 않는 구성이면 API_PREFIX 만으로 충분하다 — ROOT_PATH 는
# Swagger UI 경로 보정 외에는 필요 없다. 둘 다 설정해도 동작한다(uvicorn 이 root_path 를
# 경로 앞에 덧붙이지만 앱이 그걸 벗겨서 본다). 단 uvicorn 액세스 로그에는 프리픽스가
# 두 번 찍힌다 — 앱 로그(JSON)의 경로가 실제 라우팅 경로다.
API_PREFIX=
# 리버스 프록시 root_path (Swagger UI 경로 보정용)
ROOT_PATH=

# AWS Bedrock 설정
# 요약 품질을 높이려면 Opus 4.8 권장: anthropic.claude-opus-4-8
# (계정이 인퍼런스 프로파일을 쓰면 us.anthropic.claude-opus-4-8)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# 추론 강도 (low|medium|high|max). 비워두면 미적용.
# Opus 4.8/4.6·Sonnet 4.6에서만 지원 — Haiku·구형 모델에서는 반드시 비워둘 것.
# 요약은 medium 권장 (비용 절감 시 low).
BEDROCK_EFFORT=

# 모델에 보낼 자막 길이 상한(문자). 넘으면 잘라서 보낸다(로그에 경고).
# 상한이 없으면 긴 영상이 컨텍스트 한도를 넘겨 호출 자체가 실패한다.
BEDROCK_MAX_INPUT_CHARS=200000

# 모델 응답 토큰 상한. effort/thinking 이 켜져 있으면 사고 토큰도 이 예산을
# 함께 쓰므로 여유를 둔다(작으면 요약이 잘려 RuntimeError).
# 모델의 출력 한도를 넘기면 Bedrock 이 ValidationException 을 낸다:
# Claude 4.x/Opus 5 = 64000, Haiku 3 = 4096.
BEDROCK_MAX_OUTPUT_TOKENS=64000

# AWS Transcribe 설정 (음성 인식 폴백용)
# 비워 두면 코드 기본값 youtube-summary-audio 가 쓰이는데 그 버킷은 계정에 없다
# (NoSuchBucket). 자막 없는 영상에서만 조용히 실패하므로 반드시 채운다.
TRANSCRIBE_S3_BUCKET=youtube-summary-audio
TRANSCRIBE_POLL_INTERVAL=5
TRANSCRIBE_MAX_WAIT_TIME=600
# 음성 인식할 영상 길이 상한(초). 넘으면 다운로드하지 않는다(라이브도 거부).
TRANSCRIBE_MAX_DURATION=7200
# 오디오 다운로드·변환 전용 스레드 수. 기본 executor 와 분리해 폴백이
# 자막 추출·Bedrock 호출을 정체시키지 않게 한다.
TRANSCRIBE_DOWNLOAD_WORKERS=2

# 동시에 처리할 요약 파이프라인 수. 초과분은 순서를 기다린다.
MAX_CONCURRENT_PIPELINES=4

# 작업 상태 보관 설정 (인메모리)
# 완료·실패 작업을 이 시간(초) 동안만 조회할 수 있다. 진행 중 작업은 만료되지 않는다.
TASK_TTL_SECONDS=3600
# 작업 총 개수 상한. 넘으면 오래된 종료 작업부터 버린다.
TASK_MAX_ENTRIES=1000
