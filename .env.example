# AWS 자격 증명
# IAM Roles Anywhere 로 이관 — 장기 액세스 키를 쓰지 않는다.
# helper 가 X.509 인증서로 11시간 임시 자격증명을 받고, SDK 가 만료 전에 다시 호출한다.
AWS_PROFILE=wl-bedrock-test
# 컨테이너면 컨테이너 안의 절대 경로로: AWS_CONFIG_FILE=/app/.aws/config
AWS_REGION=us-east-1

# API 인증키
API_KEY=your-api-key-here

# API 경로 프리픽스 (예: /yts/api)
# 리버스 프록시 경로. API_PREFIX 와 ROOT_PATH 를 **둘 다** 설정하면 프리픽스가 두 번
# 적용되어 미들웨어가 보는 경로가 /yts/api/yts/api/... 가 된다(공개 경로 판정이 깨져
# 헬스체크가 401 을 받는다). 프록시가 프리픽스를 벗기지 않는 구성이면 API_PREFIX 만 쓴다.
API_PREFIX=
# 리버스 프록시 root_path (Swagger UI 경로 보정용)
ROOT_PATH=

# AWS Bedrock 설정
# 요약 품질을 높이려면 Opus 4.8 권장: anthropic.claude-opus-4-8
# (계정이 인퍼런스 프로파일을 쓰면 us.anthropic.claude-opus-4-8)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# 추론 강도 (low|medium|high|max). 비워두면 미적용.
# Opus 4.8/4.6·Sonnet 4.6에서만 지원 — Haiku·구형 모델에서는 반드시 비워둘 것.
# 요약은 medium 권장 (비용 절감 시 low).
BEDROCK_EFFORT=

# AWS Transcribe 설정 (음성 인식 폴백용)
TRANSCRIBE_S3_BUCKET=youtube-summary-audio
TRANSCRIBE_POLL_INTERVAL=5
TRANSCRIBE_MAX_WAIT_TIME=600
